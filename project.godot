; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="去狸的岛"
config/description="十日完整故事 · 与 AI 伙伴小狸一起种田、聊天、留下约定；她会忘记你，也会在雾里慢慢认出你。"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
DisplayBoot="*res://scripts/autoload/display_boot.gd"
BehaviorCollector="*res://scripts/autoload/behavior_collector.gd"
LeakageEngine="*res://scripts/autoload/leakage_engine.gd"
TaskSystem="*res://scripts/autoload/task_system.gd"
IntentParser="*res://scripts/autoload/intent_parser.gd"
IntentBridge="*res://scripts/autoload/intent_bridge.gd"
PersonaGuard="*res://scripts/autoload/persona_guard.gd"
ActionExecutor="*res://scripts/autoload/action_executor.gd"
StoryDirector="*res://scripts/autoload/story_director.gd"
StoryNodeCopy="*res://scripts/autoload/story_node_copy.gd"
StoryRouteData="*res://scripts/autoload/story_route_data.gd"
StorySlotService="*res://scripts/autoload/story_slot_service.gd"
InteractCursor="*res://scripts/ui/interact_cursor.gd"
TouchControls="*res://scripts/ui/touch_controls.gd"
StoryBeatDirector="*res://scripts/autoload/story_beat_director.gd"
WorldSnapshot="*res://scripts/autoload/world_snapshot.gd"
NpcBridge="*res://scripts/autoload/npc_bridge.gd"
MemoryService="*res://scripts/autoload/memory_service.gd"
DayJournalService="*res://scripts/autoload/day_journal_service.gd"
ResponseValidator="*res://scripts/autoload/response_validator.gd"
EndingDirector="*res://scripts/autoload/ending_director.gd"
RelationshipDirector="*res://scripts/autoload/relationship_director.gd"
CompanionDirector="*res://scripts/autoload/companion_director.gd"
CompanionAgent="*res://scripts/autoload/companion_agent.gd"
UIFontTheme="*res://scripts/autoload/ui_theme.gd"
BgmDirector="*res://scripts/autoload/bgm_director.gd"
AmbientAudio="*res://scripts/autoload/ambient_audio.gd"
MCPRuntime="*res://addons/godot_mcp/runtime/mcp_runtime.gd"
PlayerNotebookService="*res://scripts/autoload/player_notebook_service.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_width=1280
window/size/min_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[gui]

theme/default="res://theme_default.tres"

